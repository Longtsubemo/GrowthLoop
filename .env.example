# GrowthLoop environment variables (copy to .env and adjust).
# .env is gitignored — never commit real credentials.
# The un-commented values are for local development and match docker-compose.yml.

# Backend — use APP_ENV=production on the host. Production requires an explicit
# hosted DATABASE_URL, owner password, OAuth issuer, and exact HTTPS origins.
# DEBUG must remain false.
APP_ENV=development
DEBUG=false

# Required to use the dashboard and to approve remote MCP OAuth access.
# Generate a unique random value of at least 16 characters; do not commit it.
# OWNER_PASSWORD=

# Public base URL of this API. Use the exact HTTPS API URL in production.
MCP_ISSUER_URL=http://localhost:8000

# Backend — SQLAlchemy connection string (psycopg driver).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/growthloop

# Backend — small SQLAlchemy pool defaults for constrained deployments.
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=5
DB_POOL_RECYCLE_SECONDS=300
DB_CONNECT_TIMEOUT_SECONDS=10

# Backend — comma-separated origins allowed to call the API from a browser
# (defaults match the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MCP Streamable HTTP transport checks (separate from API CORS and auth).
# Hosts are exact Host-header hostnames; origins are exact browser origins.
MCP_ALLOWED_HOSTS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000,[::1],[::1]:8000,testserver
MCP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL service (used by docker-compose.yml).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=growthloop
POSTGRES_PORT=5432

# Frontend — base URL of the FastAPI backend.
# Vite only exposes variables prefixed with VITE_ to client code.
VITE_API_BASE_URL=http://localhost:8000

# Production example (configure these in the host's secret environment store;
# do not copy real credentials into this file):
# APP_ENV=production
# DEBUG=false
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>/<database>?sslmode=require
# CORS_ORIGINS=https://<dashboard-host>
# MCP_ALLOWED_HOSTS=<hosted-api-hostname>
# MCP_ALLOWED_ORIGINS=
# OWNER_PASSWORD=<generate-a-unique-long-random-value>
# MCP_ISSUER_URL=https://<hosted-api-hostname>
# DB_POOL_SIZE=1
# DB_MAX_OVERFLOW=0
# OWNER_SESSION_TTL_SECONDS=28800
# VITE_API_BASE_URL=https://<hosted-api-hostname>
# See docs/DEPLOYMENT.md for the Render Blueprint and Neon setup steps.
